[{"id":"cwt-1786126569681-jeb7","name":"呆呆by绕蔓枝","size":"medium","html":"<div class=\"mz-chat4x2-widget\" id=\"mzWidget\">\n  \n  <div style=\"display: none;\" id=\"sysResContainer\">\n    <img id=\"sys_bgImage\" src=\"{{bgImage}}\">\n    <img id=\"sys_avatar\" src=\"{{avatar}}\">\n  </div>\n\n  <img id=\"bgImgTag\" class=\"bg-media\" style=\"display:none;\">\n\n  <div class=\"main-content\">\n    <div class=\"top-section\">\n      <div class=\"avatar-area\" id=\"avatarArea\">\n        <img id=\"valAvatar\" src=\"\" alt=\"\" style=\"display:none;\">\n        <div class=\"mini-bubble\" id=\"miniBubble\">\n          <span id=\"valMiniTag\">呆</span>\n          <div class=\"dot dot1\"></div>\n          <div class=\"dot dot2\"></div>\n        </div>\n      </div>\n\n      <div class=\"chat-area\">\n        <div class=\"chat-row row-end\">\n          <div class=\"date-text\" id=\"valDate\">2026-07-19</div>\n          <div class=\"chat-bubble\" id=\"valChat1\">哎 你怎么有点呆呆的</div>\n        </div>\n        <div class=\"chat-row row-start\">\n          <div class=\"chat-bubble\" id=\"valChat2\">因为我快要被你萌晕啦</div>\n          <div class=\"time-text\" id=\"valTime\">18:33:06</div>\n          <svg class=\"heart-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"></path>\n          </svg>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"divider-wrapper\">\n      <div class=\"progress-bar\" id=\"weekProgress\"></div>\n    </div>\n\n    <div class=\"calendar-section\" id=\"valCalendar\"></div>\n  </div>\n</div>\n\n<script>\n  (async function initWidget() {\n    try {\n      const get = async (k, d) => {\n        const sysEl = document.getElementById('sys_' + k);\n        if (sysEl && sysEl.hasAttribute('src')) {\n          const src = sysEl.getAttribute('src');\n          if (src && src.trim() !== '' && !src.includes('{{') && src !== 'null') return src;\n        }\n        if (typeof widget !== 'undefined') {\n          const val = await widget.getState(k);\n          if (val) return val;\n        }\n        return d;\n      };\n\n      const forceTranslucent = (colorStr, alpha = 0.65) => {\n        let c = String(colorStr).trim().toLowerCase();\n        if (c.startsWith('#')) {\n          let hex = c.replace('#', '');\n          if (hex.length === 3) hex = hex.split('').map(x => x + x).join('');\n          if (hex.length === 6 || hex.length === 8) {\n            const r = parseInt(hex.substring(0, 2), 16);\n            const g = parseInt(hex.substring(2, 4), 16);\n            const b = parseInt(hex.substring(4, 6), 16);\n            return `rgba(${r}, ${g}, ${b}, ${alpha})`;\n          }\n        }\n        if (c.startsWith('rgb')) {\n           const match = c.match(/\\d+(\\.\\d+)?/g);\n           if (match && match.length >= 3) {\n             return `rgba(${match[0]}, ${match[1]}, ${match[2]}, ${alpha})`;\n           }\n        }\n        return `rgba(255, 255, 255, ${alpha})`;\n      };\n\n      const w = document.getElementById('mzWidget');\n\n      let bgStyle = await get('bgStyle', '纯色');\n      bgStyle = String(bgStyle).trim(); \n      const bgColor = await get('bgColor', '#FFFFFF');\n      const bgImg = await get('bgImage', '');\n      \n      w.style.backgroundColor = 'transparent';\n      w.style.backdropFilter = 'none';\n      w.style.webkitBackdropFilter = 'none';\n      const bgTag = document.getElementById('bgImgTag');\n      bgTag.style.display = 'none';\n\n      if (bgStyle === '透明' || bgStyle === '全透明') {\n        w.style.backgroundColor = 'transparent';\n      } else if (bgStyle.includes('半透') || bgStyle.includes('毛玻璃')) {\n        w.style.backgroundColor = forceTranslucent(bgColor, 0.65);\n        if (bgStyle.includes('毛玻璃')) {\n          w.style.backdropFilter = 'blur(16px)';\n          w.style.webkitBackdropFilter = 'blur(16px)';\n        }\n      } else if (bgStyle.includes('图')) {\n        if (bgImg && !bgImg.includes('{{') && bgImg !== 'null') {\n          bgTag.src = bgImg;\n          bgTag.style.display = 'block';\n        } else {\n          w.style.backgroundColor = bgColor;\n        }\n      } else {\n        w.style.backgroundColor = bgColor;\n      }\n\n      // 颜色变量\n      w.style.setProperty('--avatar-bg', await get('avatarBg', '#F2F2F2'));\n      w.style.setProperty('--mini-bg', await get('miniBg', '#F2F2F2'));\n      w.style.setProperty('--mini-text', await get('miniText', '#888888'));\n      w.style.setProperty('--chat1-bg', await get('chat1Bg', '#F2F2F2'));\n      w.style.setProperty('--chat1-text', await get('chat1Text', '#333333'));\n      w.style.setProperty('--chat2-bg', await get('chat2Bg', '#F2F2F2'));\n      w.style.setProperty('--chat2-text', await get('chat2Text', '#333333'));\n\n      w.style.setProperty('--heart-color', await get('heartColor', '#B2BEC3'));\n      w.style.setProperty('--date-time-color', await get('dateTimeColor', '#888888'));\n      w.style.setProperty('--cal-week-color', await get('calWeekColor', '#333333'));\n      w.style.setProperty('--cal-num-color', await get('calNumColor', '#888888'));\n      w.style.setProperty('--progress-color', await get('progressColor', '#DCDDE1'));\n      w.style.setProperty('--active-bg-color', await get('activeBgColor', '#E8E8E8'));\n      w.style.setProperty('--active-num-color', await get('activeNumColor', '#333333'));\n\n      // 🌟 新增字号变量 (清理掉用户可能误填的 px 单位)\n      const parseSize = (val, def) => String(val).replace(/px/g, '').trim() || def;\n      w.style.setProperty('--chat-font-size', parseSize(await get('chatTextSize', '13'), '13') + 'px');\n      w.style.setProperty('--date-font-size', parseSize(await get('dateTimeSize', '12'), '12') + 'px');\n      w.style.setProperty('--mini-font-size', parseSize(await get('miniTextSize', '13'), '13') + 'px');\n      w.style.setProperty('--cal-week-size', parseSize(await get('calWeekSize', '12'), '12') + 'px');\n      w.style.setProperty('--cal-num-size', parseSize(await get('calNumSize', '12'), '12') + 'px');\n\n      // 头像渲染\n      const avatar = await get('avatar', '');\n      const avatarEl = document.getElementById('valAvatar');\n      if (avatar && !avatar.includes('{{') && avatar !== 'null') {\n        avatarEl.src = avatar;\n        avatarEl.style.display = 'block';\n      } else {\n        avatarEl.style.display = 'none';\n      }\n\n      document.getElementById('valMiniTag').textContent = await get('miniTag', '呆');\n      const c1 = await get('chat1', '哎 你怎么有点呆呆的');\n      const c2 = await get('chat2', '因为我快要被你萌晕啦');\n      // 这里的 <br> 可以让回车键生效\n      document.getElementById('valChat1').innerHTML = c1.replace(/\\n/g, '<br>');\n      document.getElementById('valChat2').innerHTML = c2.replace(/\\n/g, '<br>');\n\n      // 日历与时间引擎\n      let lastDateStr = '';\n      const updateTimeAndCalendar = () => {\n        const now = new Date();\n        \n        const hh = String(now.getHours()).padStart(2, '0');\n        const mm = String(now.getMinutes()).padStart(2, '0');\n        const ss = String(now.getSeconds()).padStart(2, '0');\n        document.getElementById('valTime').textContent = `${hh}:${mm}:${ss}`;\n\n        const dayOfWeek = now.getDay(); \n        const secondsToday = now.getHours() * 3600 + now.getMinutes() * 60 + now.getSeconds();\n        const totalWeekSeconds = 7 * 86400; \n        const passedWeekSeconds = dayOfWeek * 86400 + secondsToday;\n        const weekPercent = (passedWeekSeconds / totalWeekSeconds) * 100;\n        \n        document.getElementById('weekProgress').style.width = `${Math.min(100, Math.max(0, weekPercent))}%`;\n\n        const yyyy = now.getFullYear();\n        const MM = String(now.getMonth() + 1).padStart(2, '0');\n        const DD = String(now.getDate()).padStart(2, '0');\n        const dateStr = `${yyyy}-${MM}-${DD}`;\n        \n        if (dateStr !== lastDateStr) {\n          lastDateStr = dateStr;\n          document.getElementById('valDate').textContent = dateStr;\n          \n          const todayDate = now.getDate();\n          const days = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];\n          \n          let calHtml = '';\n          for (let i = 0; i < 7; i++) {\n            const d = new Date(now);\n            d.setDate(todayDate - dayOfWeek + i);\n            const dateNum = String(d.getDate()).padStart(2, '0');\n            const isActive = (i === dayOfWeek) ? 'active' : '';\n            calHtml += `\n              <div class=\"cal-day\">\n                <div class=\"cal-name\">${days[i]}</div>\n                <div class=\"cal-num ${isActive}\">${dateNum}</div>\n              </div>\n            `;\n          }\n          document.getElementById('valCalendar').innerHTML = calHtml;\n        }\n      };\n\n      updateTimeAndCalendar();\n      setInterval(updateTimeAndCalendar, 1000);\n\n    } catch (e) { console.warn(\"Widget Error:\", e); }\n  })();\n</script>\n","css":".mz-chat4x2-widget {\n  width: 100%; height: 100%; position: relative;\n  font-family: -apple-system, BlinkMacSystemFont, \"PingFang SC\", sans-serif;\n  box-sizing: border-box; overflow: hidden;\n  border-radius: 20px;\n  padding: 16px 20px;\n}\n\n.bg-media {\n  position: absolute; top: 0; left: 0; \n  width: 100%; height: 100%; object-fit: cover; z-index: 0;\n  border-radius: inherit;\n  pointer-events: none;\n}\n\n.main-content {\n  position: relative; z-index: 1;\n  width: 100%; height: 100%;\n  display: flex; flex-direction: column;\n  justify-content: space-between;\n}\n\n.top-section {\n  display: flex; align-items: center; gap: 12px;\n  flex: 1; padding-bottom: 8px;\n}\n\n.avatar-area {\n  position: relative; flex-shrink: 0;\n  width: 72px; height: 72px;\n  border-radius: 50%;\n  background: var(--avatar-bg);\n  display: flex; align-items: center; justify-content: center;\n}\n.avatar-area img {\n  width: 100%; height: 100%; object-fit: cover; border-radius: 50%;\n}\n\n.mini-bubble {\n  position: absolute; top: -4px; right: -12px;\n  background: var(--mini-bg);\n  color: var(--mini-text);\n  /* 🌟 字号应用 */\n  font-size: var(--mini-font-size); \n  font-weight: bold;\n  padding: 4px 9px; border-radius: 12px;\n  z-index: 2;\n  box-shadow: 0 2px 6px rgba(0,0,0,0.05);\n}\n.mini-bubble .dot {\n  position: absolute; background: var(--mini-bg); border-radius: 50%;\n}\n.mini-bubble .dot1 { width: 7px; height: 7px; bottom: -5px; left: 4px; }\n.mini-bubble .dot2 { width: 4px; height: 4px; bottom: -10px; left: 1px; }\n\n.chat-area {\n  flex: 1; display: flex; flex-direction: column;\n  gap: 10px; justify-content: center;\n}\n.chat-row {\n  display: flex; align-items: center; gap: 8px;\n}\n.row-end { justify-content: flex-end; }\n.row-start { justify-content: flex-start; }\n\n/* 🌟 核心终极自适配机制 */\n.chat-bubble {\n  padding: 8px 14px; border-radius: 16px;\n  /* 字号应用 */\n  font-size: var(--chat-font-size); \n  font-weight: 500;\n  width: fit-content; \n  text-align: center; \n  /* 放宽了限制，最高撑到 75% 然后换行 */\n  max-width: 75%; \n  /* 保障中英文都能完美断行不断框 */\n  word-break: break-word; \n  white-space: pre-wrap; \n  line-height: 1.45;\n}\n\n#valChat1 {\n  background: var(--chat1-bg);\n  color: var(--chat1-text);\n}\n\n#valChat2 {\n  background: var(--chat2-bg);\n  color: var(--chat2-text);\n}\n\n.date-text, .time-text {\n  color: var(--date-time-color); \n  /* 🌟 字号应用 */\n  font-size: var(--date-font-size); \n  font-weight: 500; \n  font-family: \"DIN Alternate\", sans-serif; \n  letter-spacing: 0.5px;\n}\n\n.heart-icon {\n  width: 16px; height: 16px; \n  color: var(--heart-color, #b2bec3); \n  stroke-width: 2.2; \n  flex-shrink: 0; \n  margin-left: auto;\n}\n\n.divider-wrapper {\n  width: 100%; height: 3px; background: rgba(0,0,0,0.06);\n  border-radius: 2px; margin: 4px 0 8px 0; overflow: hidden;\n}\n.progress-bar {\n  height: 100%; background: var(--progress-color, #DCDDE1); border-radius: 2px; transition: width 1s linear;\n}\n\n.calendar-section {\n  display: flex; justify-content: space-between; align-items: center;\n  width: 100%;\n}\n.cal-day {\n  display: flex; flex-direction: column; align-items: center; gap: 5px; flex: 1;\n}\n\n.cal-name {\n  color: var(--cal-week-color); \n  /* 🌟 字号应用 */\n  font-size: var(--cal-week-size); \n  font-weight: 600; \n  font-family: \"Arial\", sans-serif;\n}\n\n.cal-num {\n  color: var(--cal-num-color); \n  /* 🌟 字号应用 */\n  font-size: var(--cal-num-size); \n  font-weight: bold; \n  font-family: \"Arial\", sans-serif;\n  width: 30px; height: 24px; border-radius: 6px;\n  display: flex; align-items: center; justify-content: center;\n}\n\n.cal-num.active {\n  background: var(--active-bg-color); \n  color: var(--active-num-color);\n}\n","images":{},"userFields":[{"type":"select","key":"bgStyle","label":"背景样式","options":["纯色⁠","颜色半透","毛玻璃⁠","⁠透明⁠"]},{"label":"背景颜色","key":"bgColor","type":"color"},{"label":"头像角标","key":"miniTag","type":"text"},{"label":"角标气泡颜色","key":"miniBg","type":"color"},{"label":"角标文字颜色","key":"miniText","type":"color"},{"label":"文案1","key":"chat1","type":"text"},{"label":"文案1气泡颜色","key":"chat1Bg","type":"color"},{"label":"文案1文字颜色","key":"chat1Text","type":"color"},{"label":"文案2","key":"chat2","type":"text"},{"label":"文案2气泡颜色","key":"chat2Bg","type":"color"},{"label":"文案2文字颜色","key":"chat2Text","type":"color"},{"label":"日期&时间颜色","key":"dateTimeColor","type":"color"},{"label":"当日高亮数字色","key":"activeNumColor","type":"color"},{"label":"周进度条颜色","key":"progressColor","type":"color"},{"label":"英文颜色","key":"calWeekColor","type":"color"},{"label":"日历数字颜色","key":"calNumColor","type":"color"},{"label":"高亮背景色","key":"activeBgColor","type":"color"},{"label":"爱心颜色","key":"heartColor","type":"color"},{"type":"select","key":"chatTextSize","label":"文案字号","options":["10px","11px","12px","13px","14px","15px","16px","17px","18px"]},{"type":"select","key":"dateTimeSize","label":"日期时间字号","options":["10px","11px","12px","13px","14px","15px","16px","17px","18px"]},{"type":"select","key":"miniTextSize","label":"角标字号","options":["10px","11px","12px","13px","14px","15px","16px","17px","18px"]},{"type":"select","key":"calWeekSize","label":"英文字号","options":["10px","11px","12px","13px","14px","15px","16px","17px","18px"]},{"type":"select","key":"calNumSize","label":"日历数字字号","options":["10px","11px","12px","13px","14px","15px","16px","17px","18px"]}],"updatedAt":1792698523194,"imagesRefs":{"avatar":{"ref":1932}}},{"id":"cwt-1787749951734-blot","name":"請和我永遠在一起by绕蔓枝","size":"large","html":"<div class=\"mz-tweet4x4-widget\" id=\"mzWidget\">\n  \n  <div style=\"display: none;\" id=\"sysResContainer\">\n    <img id=\"sys_bgImage\" src=\"{{bgImage}}\">\n    <img id=\"sys_mainAvatar\" src=\"{{mainAvatar}}\">\n    <img id=\"sys_c1Avatar\" src=\"{{c1Avatar}}\">\n    <img id=\"sys_c2Avatar\" src=\"{{c2Avatar}}\">\n  </div>\n\n  <img id=\"bgImgTag\" class=\"bg-media\" style=\"display:none;\">\n\n  <div class=\"main-content\">\n    \n    <!-- === 主动态区 === -->\n    <div class=\"main-post\">\n      <div class=\"post-header\">\n        <div class=\"avatar-box circular\">\n          <img id=\"valMainAvatar\" src=\"\" style=\"display:none;\">\n        </div>\n        <div class=\"user-info\">\n          <div class=\"user-name\" id=\"valMainName\">user</div>\n          <div class=\"user-handle\" id=\"valMainHandle\">@user</div>\n        </div>\n        <div class=\"more-icon\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"5\" cy=\"12\" r=\"2\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><circle cx=\"19\" cy=\"12\" r=\"2\"/></svg>\n        </div>\n      </div>\n\n      <div class=\"post-body\" id=\"valMainText\">\n        宇宙這麼大，你消失之後我該去哪裏找你\n      </div>\n\n      <div class=\"post-meta\" id=\"metaContainer\">\n        <!-- JS 实时生成高亮与常规文字 -->\n      </div>\n    </div>\n\n    <!-- === 评论区 === -->\n    <div class=\"comments-list\">\n      \n      <!-- 🌟 评论 1 独立化 -->\n      <div class=\"comment-item\" id=\"comment1\">\n        <div class=\"avatar-box squircle\">\n          <img id=\"valC1Avatar\" src=\"\" style=\"display:none;\">\n        </div>\n        <div class=\"comment-content\">\n          <div class=\"user-handle c-handle\" id=\"valC1Handle\">@user</div>\n          <div class=\"comment-text c-text\" id=\"valC1Text\">永遠 永遠在一起吧</div>\n        </div>\n      </div>\n\n      <!-- 🌟 评论 2 独立化 -->\n      <div class=\"comment-item\" id=\"comment2\">\n        <div class=\"avatar-box squircle\">\n          <img id=\"valC2Avatar\" src=\"\" style=\"display:none;\">\n        </div>\n        <div class=\"comment-content\">\n          <div class=\"user-handle c-handle\" id=\"valC2Handle\">@char</div>\n          <div class=\"comment-text c-text\" id=\"valC2Text\">我也是這樣想的 請和我永遠在一起</div>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</div>\n\n<script>\n  (async function initWidget() {\n    try {\n      const get = async (k, d) => {\n        const sysEl = document.getElementById('sys_' + k);\n        if (sysEl && sysEl.hasAttribute('src')) {\n          const src = sysEl.getAttribute('src');\n          if (src && src.trim() !== '' && !src.includes('{{') && src !== 'null') return src;\n        }\n        if (typeof widget !== 'undefined') {\n          const val = await widget.getState(k);\n          if (val) return val;\n        }\n        return d;\n      };\n\n      const forceTranslucent = (colorStr, alpha = 0.65) => {\n        let c = String(colorStr).trim().toLowerCase();\n        if (c.startsWith('#')) {\n          let hex = c.replace('#', '');\n          if (hex.length === 3) hex = hex.split('').map(x => x + x).join('');\n          if (hex.length === 6 || hex.length === 8) {\n            const r = parseInt(hex.substring(0, 2), 16);\n            const g = parseInt(hex.substring(2, 4), 16);\n            const b = parseInt(hex.substring(4, 6), 16);\n            return `rgba(${r}, ${g}, ${b}, ${alpha})`;\n          }\n        }\n        if (c.startsWith('rgb')) {\n           const match = c.match(/\\d+(\\.\\d+)?/g);\n           if (match && match.length >= 3) {\n             return `rgba(${match[0]}, ${match[1]}, ${match[2]}, ${alpha})`;\n           }\n        }\n        return `rgba(255, 255, 255, ${alpha})`;\n      };\n\n      const w = document.getElementById('mzWidget');\n\n      // 整体背景\n      let bgStyle = await get('bgStyle', '纯色');\n      bgStyle = String(bgStyle).trim(); \n      const bgColor = await get('bgColor', '#FFFFFF');\n      const bgImg = await get('bgImage', '');\n      \n      w.style.backgroundColor = 'transparent';\n      w.style.backdropFilter = 'none';\n      w.style.webkitBackdropFilter = 'none';\n      const bgTag = document.getElementById('bgImgTag');\n      bgTag.style.display = 'none';\n\n      if (bgStyle === '透明' || bgStyle === '全透明') {\n        w.style.backgroundColor = 'transparent';\n      } else if (bgStyle.includes('半透') || bgStyle.includes('毛玻璃')) {\n        w.style.backgroundColor = forceTranslucent(bgColor, 0.65);\n        if (bgStyle.includes('毛玻璃')) {\n          w.style.backdropFilter = 'blur(20px)';\n          w.style.webkitBackdropFilter = 'blur(20px)';\n        }\n      } else if (bgStyle.includes('图')) {\n        if (bgImg && !bgImg.includes('{{') && bgImg !== 'null') {\n          bgTag.src = bgImg;\n          bgTag.style.display = 'block';\n        } else {\n          w.style.backgroundColor = bgColor;\n        }\n      } else {\n        w.style.backgroundColor = bgColor;\n      }\n\n      // 🌟 主动态颜色变量\n      w.style.setProperty('--name-color', await get('nameColor', '#7F8C8D'));\n      w.style.setProperty('--handle-color', await get('handleColor', '#74B9FF'));\n      w.style.setProperty('--main-text-color', await get('mainTextColor', '#2D3436'));\n      w.style.setProperty('--meta-hl-color', await get('metaHighlightColor', '#74B9FF'));\n      w.style.setProperty('--meta-norm-color', await get('metaNormalColor', '#A4B0BE'));\n      w.style.setProperty('--avatar-placeholder', await get('avatarPlaceholder', '#F1F2F6'));\n\n      // 🌟 评论1 独立颜色\n      w.style.setProperty('--c1-handle-color', await get('c1HandleColor', '#74B9FF'));\n      w.style.setProperty('--c1-text-color', await get('c1TextColor', '#636E72'));\n      w.style.setProperty('--c1-bg', await get('c1BgColor', '#FFFFFF'));\n      w.style.setProperty('--c1-dot', await get('c1DotColor', '#EEEEEE'));\n      w.style.setProperty('--c1-border', await get('c1BorderColor', '#EEEEEE'));\n\n      // 🌟 评论2 独立颜色\n      w.style.setProperty('--c2-handle-color', await get('c2HandleColor', '#74B9FF'));\n      w.style.setProperty('--c2-text-color', await get('c2TextColor', '#636E72'));\n      w.style.setProperty('--c2-bg', await get('c2BgColor', '#FFFFFF'));\n      w.style.setProperty('--c2-dot', await get('c2DotColor', '#EEEEEE'));\n      w.style.setProperty('--c2-border', await get('c2BorderColor', '#EEEEEE'));\n\n      // 🌟 字号独立引擎 (清理 px)\n      const parseSize = (val, def) => String(val).replace(/px/g, '').trim() || def;\n      w.style.setProperty('--name-size', parseSize(await get('nameSize', '15'), '15') + 'px');\n      w.style.setProperty('--handle-size', parseSize(await get('handleSize', '14'), '14') + 'px');\n      w.style.setProperty('--main-text-size', parseSize(await get('mainTextSize', '17'), '17') + 'px');\n      w.style.setProperty('--meta-size', parseSize(await get('metaSize', '13'), '13') + 'px');\n      \n      // 评论区统一字号\n      w.style.setProperty('--comment-handle-size', parseSize(await get('commentHandleSize', '14'), '14') + 'px');\n      w.style.setProperty('--comment-text-size', parseSize(await get('commentTextSize', '14'), '14') + 'px');\n\n      // 头像绑定\n      const bindAvatar = async (key, elId) => {\n        const url = await get(key, '');\n        const el = document.getElementById(elId);\n        if (url && !url.includes('{{') && url !== 'null') {\n          el.src = url; el.style.display = 'block';\n        } else {\n          el.style.display = 'none';\n        }\n      };\n      await bindAvatar('mainAvatar', 'valMainAvatar');\n      await bindAvatar('c1Avatar', 'valC1Avatar');\n      await bindAvatar('c2Avatar', 'valC2Avatar');\n\n      // 文本内容绑定\n      document.getElementById('valMainName').textContent = await get('mainName', 'user');\n      document.getElementById('valMainHandle').textContent = await get('mainHandle', '@user');\n      document.getElementById('valC1Handle').textContent = await get('c1Handle', '@user');\n      document.getElementById('valC1Text').textContent = await get('c1Text', '永遠 永遠在一起吧');\n      document.getElementById('valC2Handle').textContent = await get('c2Handle', '@char');\n      document.getElementById('valC2Text').textContent = await get('c2Text', '我也是這樣想的 請和我永遠在一起');\n\n      const mainT = await get('mainText', '宇宙這麼大，你消失之後我該去哪裏找你');\n      document.getElementById('valMainText').innerHTML = mainT.replace(/\\n/g, '<br>');\n\n      // 实时时间\n      const updateTime = () => {\n        const now = new Date();\n        const hh = String(now.getHours()).padStart(2, '0');\n        const mm = String(now.getMinutes()).padStart(2, '0');\n        const ampm = now.getHours() >= 12 ? '下午' : '上午';\n        const yyyy = now.getFullYear();\n        const dd = now.getDate();\n        const timeStr = `${hh}:${mm} ${ampm}`;\n\n        document.getElementById('metaContainer').innerHTML = `\n          <span class=\"meta-hl\">${timeStr}</span>\n          <span class=\"meta-norm\"> . </span>\n          <span class=\"meta-hl\">${yyyy}</span>\n          <span class=\"meta-norm\">转推 </span>\n          <span class=\"meta-hl\">${dd}</span>\n          <span class=\"meta-norm\">万次查看</span>\n        `;\n      };\n      \n      updateTime();\n      setInterval(updateTime, 1000);\n\n    } catch (e) { console.warn(\"Widget Error:\", e); }\n  })();\n</script>\n","css":".mz-tweet4x4-widget {\n  width: 100%; height: 100%; position: relative;\n  font-family: -apple-system, BlinkMacSystemFont, \"PingFang SC\", sans-serif;\n  box-sizing: border-box; overflow: hidden;\n  border-radius: 20px;\n  padding: 20px 24px;\n}\n\n.bg-media {\n  position: absolute; top: 0; left: 0; \n  width: 100%; height: 100%; object-fit: cover; z-index: 0;\n  border-radius: inherit; pointer-events: none;\n}\n\n.main-content {\n  position: relative; z-index: 1;\n  width: 100%; height: 100%;\n  display: flex; flex-direction: column;\n  justify-content: space-evenly; \n}\n\n/* === 头像通用 === */\n.avatar-box {\n  background: var(--avatar-placeholder);\n  flex-shrink: 0; overflow: hidden;\n  display: flex; align-items: center; justify-content: center;\n}\n.avatar-box img { width: 100%; height: 100%; object-fit: cover; }\n\n.circular { border-radius: 50%; width: 72px; height: 72px; } \n.squircle { border-radius: 12px; width: 52px; height: 52px; } \n\n/* === 主动态区域 === */\n.main-post {\n  display: flex; flex-direction: column; gap: 14px;\n}\n\n.post-header {\n  display: flex; align-items: center; gap: 12px;\n}\n\n.user-info {\n  display: flex; flex-direction: column; justify-content: center; gap: 2px; flex: 1;\n}\n\n.user-name {\n  color: var(--name-color);\n  font-size: var(--name-size);\n  font-weight: 600;\n}\n\n.user-handle {\n  color: var(--handle-color);\n  font-size: var(--handle-size);\n  font-weight: 500; letter-spacing: 0.5px;\n}\n\n.more-icon {\n  color: var(--name-color); flex-shrink: 0; margin-bottom: auto; margin-top: 4px; opacity: 0.8;\n}\n\n.post-body {\n  color: var(--main-text-color);\n  font-size: var(--main-text-size);\n  font-weight: 500;\n  line-height: 1.5;\n  word-wrap: break-word; white-space: pre-wrap;\n}\n\n/* 数据分离着色与统一字号 */\n.post-meta {\n  font-size: var(--meta-size);\n  font-weight: 500;\n  display: flex; flex-wrap: wrap; gap: 2px; align-items: center;\n}\n.meta-hl {\n  color: var(--meta-hl-color);\n  font-family: \"DIN Alternate\", -apple-system, sans-serif;\n}\n.meta-norm {\n  color: var(--meta-norm-color);\n  margin: 0 1px;\n}\n\n/* === 评论区域 === */\n.comments-list {\n  display: flex; flex-direction: column; gap: 12px;\n}\n\n.comment-item {\n  display: flex; gap: 12px; align-items: center;\n  padding: 12px 14px;\n  border-radius: 8px; \n  background-size: 14px 14px;\n}\n\n/* 🌟 评论1 专属独立渲染 */\n#comment1 {\n  border: 1px solid var(--c1-border);\n  background-color: var(--c1-bg);\n  background-image: radial-gradient(var(--c1-dot) 1px, transparent 1px);\n}\n#valC1Handle { color: var(--c1-handle-color); }\n#valC1Text { color: var(--c1-text-color); }\n\n/* 🌟 评论2 专属独立渲染 */\n#comment2 {\n  border: 1px solid var(--c2-border);\n  background-color: var(--c2-bg);\n  background-image: radial-gradient(var(--c2-dot) 1px, transparent 1px);\n}\n#valC2Handle { color: var(--c2-handle-color); }\n#valC2Text { color: var(--c2-text-color); }\n\n/* 🌟 评论区通用结构设定（共用字号） */\n.comment-content {\n  display: flex; flex-direction: column; gap: 6px; flex: 1;\n}\n\n.c-handle {\n  font-size: var(--comment-handle-size);\n  font-weight: 500; letter-spacing: 0.5px;\n}\n\n.c-text {\n  font-size: var(--comment-text-size);\n  font-weight: 500; line-height: 1.4;\n  word-wrap: break-word;\n}\n","images":{},"userFields":[{"options":["纯色⁠","⁠颜色半透⁠","毛玻璃⁠","透明"],"type":"select","key":"bgStyle","label":"背景样式"},{"key":"bgColor","label":"背景颜色","type":"color"},{"key":"mainName","label":"主昵称","type":"text"},{"label":"主昵称颜色","key":"nameColor","type":"color"},{"options":["10px","11px","12px","13px","14px","15px","16px","17px","18px"],"type":"select","key":"nameSize","label":"主昵称字号"},{"label":"主账号","key":"mainHandle","type":"text"},{"label":"主账号颜色","key":"handleColor","type":"color"},{"options":["10px","11px","12px","13px","14px","15px","16px","17px","18px"],"type":"select","key":"handleSize","label":"主账号字号"},{"label":"主内容","key":"mainText","type":"text"},{"label":"主内容颜色","key":"mainTextColor","type":"color"},{"options":["10px","11px","12px","13px","14px","15px","16px","17px","18px"],"type":"select","key":"mainTextSize","label":"主内容字号"},{"label":"数据颜色","key":"metaNormalColor","type":"color"},{"label":"数据高亮颜色","key":"metaHighlightColor","type":"color"},{"options":["10px","11px","12px","13px","14px","15px","16px","17px","18px"],"type":"select","key":"metaSize","label":"数据字号"},{"label":"昵称1","key":"c1Handle","type":"text"},{"label":"昵称1颜色","key":"c1HandleColor","type":"color"},{"label":"文案1","key":"c1Text","type":"text"},{"key":"c1TextColor","label":"文案1颜色","type":"color"},{"key":"c1BgColor","label":"评论1背景色","type":"color"},{"key":"c1DotColor","label":"评论1波点色","type":"color"},{"key":"c1BorderColor","label":"评论1边框色","type":"color"},{"key":"c2Handle","label":"昵称2","type":"text"},{"key":"c2HandleColor","label":"昵称2颜色","type":"color"},{"key":"c2Text","label":"文案2","type":"text"},{"key":"c2TextColor","label":"文案2颜色","type":"color"},{"key":"c2BgColor","label":"评论2背景色","type":"color"},{"key":"c2DotColor","label":"评论2波点色","type":"color"},{"key":"c2BorderColor","label":"评论2边框色","type":"color"},{"options":["10px","11px","12px","13px","14px","15px","16px","17px","18px"],"type":"select","key":"commentHandleSize","label":"评论账号字号"},{"options":["10px","11px","12px","13px","14px","15px","16px","17px","18px"],"type":"select","key":"commentTextSize","label":"评论文案字号"}],"updatedAt":1792698397154,"imagesRefs":{"c1Avatar":{"ref":1926},"c2Avatar":{"ref":1928},"mainAvatar":{"ref":1929}}}]