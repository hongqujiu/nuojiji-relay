[{"id":"a1791958696432","name":"云溯城","worldview":"月汐海环抱云溯城，机场与轻轨枢纽连通内外。新城有科创园、会展中心，旧城保留钟楼与夜市烟火。临湖别墅、低密洋房错落，档案馆、艺术馆沉淀记忆，生态湿地与纪念园静立郊野。湖光、山色、市井、殿堂在此交融，一座虚实相生的滨海都会。","characters":"0b805ffb-84cb-4e87-8d2d-269eef78a3f4, 13637717-a6b2-4057-8735-76dd43694b43, 2b93610a-c862-4547-81b7-5458ff4c408c, 42bd4a47-48ac-46c2-9fac-f45daadbdf94, 490f6b93-0dbd-4902-9276-a5ada07300a6, 51a336ac-3609-442f-a6a4-1728f5cc8193, 648aad11-9e24-4ac4-b0c5-63515ffc81e4, e62ca703-6340-44a7-b99b-58bb9f1b35a2","bgImage":null,"customBg":null,"mapTag":"现代都市 (Modern City)","mapStyle":"modern_city","colorScheme":"blue_steel","geography":{"mountains":[{"x":16,"y":18,"scale":1.4},{"x":23,"y":22,"scale":1.8},{"x":31,"y":20,"scale":1.5},{"x":38,"y":26,"scale":1.2}],"rivers":[{"points":[[28,24],[37,40],[48,54],[58,68],[70,84]],"width":2.2}],"forests":[{"cx":20,"cy":24,"r":11},{"cx":76,"cy":46,"r":13},{"cx":18,"cy":66,"r":9}],"hasCoastline":true,"nebulae":[],"districts":[{"x":24,"y":42,"w":18,"h":18},{"x":44,"y":38,"w":22,"h":24},{"x":58,"y":22,"w":20,"h":18}],"roads":[{"from":0,"to":1},{"from":0,"to":2},{"from":0,"to":4},{"from":0,"to":5},{"from":2,"to":8},{"from":3,"to":4},{"from":7,"to":8}]},"locations":[{"id":1,"name":"云溯钟楼广场","type":"rest","landmark":"tower","x":55.528070887445885,"y":41.956463173870404,"description":"旧城的核心标志，青铜钟声贯穿古今，也是新旧街区灵气与市井人流汇集的黄金枢纽。","hasEncounter":false,"customBg":""},{"id":2,"name":"见素暮色清吧","type":"play","landmark":"safehouse","x":69.38455213406385,"y":54.44969197062703,"description":"临海悬崖边的轻奢爵士酒吧，老板调酒手法优雅却气场冰冷，常有微风与暗流在此交织盘旋。","hasEncounter":true},{"id":3,"name":"观者大楼","type":"work","landmark":"terminal","x":45.87090509588068,"y":23.804319439512312,"description":"外表是一座静穆的现代档案馆，深处则是观者首领监测全城怨气波动、派发捉鬼星级委托的指挥中枢。","hasEncounter":false,"customBg":""},{"id":4,"name":"云溯大学·格致理科楼","type":"work","landmark":"arcology","x":36.362592688886636,"y":53.827574626707936,"description":"绿树掩映的高等学府，秦梧日常在此讲授物理课程，明净的阶梯教室偶有灵力微光闪烁。","hasEncounter":false},{"id":5,"name":"捉鬼事务所","type":"rest","landmark":"safehouse","x":35.08879267704951,"y":29.777810629312096,"description":"由秦梧与骆云影合资盘下的独栋事务所，屋内堆满游戏卡带与外卖餐盒，也是二人休整商榷的秘密基地。","hasEncounter":true,"customBg":""},{"id":6,"name":"美食街","type":"food","landmark":"market","x":53.00629058441559,"y":54.267462660223885,"description":"热气蒸腾的市井老街，炸串与奶茶香气扑鼻，充满着各种美食","hasEncounter":true,"customBg":""},{"id":7,"name":"碧水汀兰低密宅邸","type":"rest","landmark":"safehouse","x":24.513115424614448,"y":50.15784708658854,"description":"枕湖而建的幽静私邸，窗外荷叶田田，庭院松香怡人，是避开尘嚣与同伴温存小憩的归宿。","hasEncounter":false},{"id":8,"name":"溯海国际空港枢纽","type":"landmark","landmark":"terminal","x":76.23055647152326,"y":22.558064778645832,"description":"巨型穹顶钢构连通高架轻轨，潮汐般的人流往返于都会与外省，是现代云溯城对外的明珠门厅。","hasEncounter":false,"customBg":""},{"id":9,"name":"月汐科创智慧园区","type":"work","landmark":"arcology","x":62,"y":34,"description":"玻璃幕墙林立的科技走廊，黑客蛇玉常年在此隐秘构筑覆盖整座都会的异常灵波防御防火墙。","hasEncounter":false},{"id":10,"name":"红羽湿地生态公园","type":"nature","landmark":"grove","x":57.39773995535713,"y":20.223569399350648,"description":"水草丰茂的滨海红树林湿地，朱雀神鸟偶尔在此栖息晒羽，赤色流火与落日晚霞在此化为一体。","hasEncounter":true},{"id":11,"name":"旧港沉船维修泊区","type":"danger","landmark":"port","x":82,"y":76,"description":"废弃锈蚀的深水港坞，常有怨灵纠缠于冷铁之间，锁魂链破空的铿锵声与黑色长靴踢踏声时常回荡。","hasEncounter":true},{"id":12,"name":"苍岚古修纪念陵园","type":"mystery","landmark":"temple","x":19.82184392755682,"y":25.099369461918293,"description":"依偎在北麓孤峰中的古老祭坛，五灵剑残存的剑意与松木冷香经久不散，记载着初代捉鬼师的壮烈宿命。","hasEncounter":false},{"id":1792093093500,"name":"郊区","type":"nature","hasEncounter":false,"x":10.129870129870131,"y":64.63546422652868,"landmark":"nature","description":"有未完全开发和废弃的大楼，各种灵异事件频出","customBg":""},{"id":1792093177646,"name":"别墅","type":"rest","hasEncounter":false,"x":75.6033233543495,"y":56.156382374949274,"landmark":"rest","description":"青龙的家，装修古典","customBg":""},{"id":1792093217070,"name":"温馨家园","type":"rest","hasEncounter":false,"x":28.05982317243303,"y":41.24232965114313,"landmark":"landmark","description":"普通小区，秦梧的家，也是从小长大的地方","customBg":""},{"id":1792093243865,"name":"别墅区","type":