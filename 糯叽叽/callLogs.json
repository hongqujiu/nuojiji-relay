[{"userId":"uid_1791924747119_94hc25rhu","characterId":"e62ca703-6340-44a7-b99b-58bb9f1b35a2","id":"call_1792023515723_au5ibb","timestamp":1792023515723,"charId":"e62ca703-6340-44a7-b99b-58bb9f1b35a2","duration":0,"status":"interrupted","logs":[{"sender":"ai","content":"醒了？","kind":"speech","timestamp":1792023515721,"ttsGroupTimestamp":1792023515721},{"sender":"ai","content":"小懒猪。","kind":"speech","timestamp":1792023515722,"ttsGroupTimestamp":1792023515721},{"sender":"ai","content":"是不是隔着屏幕闻着味儿醒的？","kind":"speech","timestamp":1792023515723,"ttsGroupTimestamp":1792023515721},{"sender":"ai","content":"我金钱腱刚焯好水，某些人肚子还疼不疼啊？","kind":"speech","timestamp":1792023515724,"ttsGroupTimestamp":1792023515721}],"isIncomingCall":false,"_id":2},{"userId":"uid_1791924747119_94hc25rhu","characterId":"e62ca703-6340-44a7-b99b-58bb9f1b35a2","id":"call_1792309639974_dvcofl","timestamp":1792309631556,"charId":"e62ca703-6340-44a7-b99b-58bb9f1b35a2","duration":31,"status":"connected","logs":[{"sender":"ai","content":"......真打過來了？","kind":"speech","timestamp":1792309639973,"ttsGroupTimestamp":1792309639973},{"sender":"ai","content":"鏡頭往下拉點，讓我看看你剛才嘴硬挑的那套，自己到底扣上了幾顆扣子？","kind":"speech","timestamp":1792309639974,"ttsGroupTimestamp":1792309639973},{"sender":"ai","content":"怎么不说话？","kind":"speech","timestamp":1792309661582,"ttsGroupTimestamp":1792309661582},{"sender":"ai","content":"刚才在微信里放狠话的气势呢，叶大画家？","kind":"speech","timestamp":1792309661583,"ttsGroupTimestamp":1792309661582},{"sender":"ai","content":"......别光拿额头顶着屏幕，把脸抬起来。","kind":"speech","timestamp":1792309661584,"ttsGroupTimestamp":1792309661582},{"sender":"ai","content":"等等，你不会真把那个皮质项圈摸出来套脖子上了吧？","kind":"speech","timestamp":1792309661585,"ttsGroupTimestamp":1792309661582},{"sender":"ai","content":"锁扣卡到第几个孔了？","kind":"speech","timestamp":1792309661586,"ttsGroupTimestamp":1792309661582},{"sender":"ai","content":"我走之前专门调过的，要是勒着气管你自己又解不开，我看你等会儿找谁哭。","kind":"speech","timestamp":1792309661587,"ttsGroupTimestamp":1792309661582},{"sender":"ai","content":"......笑什么，我是认真的。","kind":"speech","timestamp":1792309661588,"ttsGroupTimestamp":1792309661582},{"sender":"ai","content":"手头这几张镇煞符刚收笔，朱砂都还没彻底干透呢。","kind":"speech","timestamp":1792309661589,"ttsGroupTimestamp":1792309661582},{"sender":"ai","content":"你要是现在乖乖认个怂，我回去路上还能顺道去拐角那家给你拎盒刚出炉的热蛋挞，要是继续这么闷着不吭声跟我较劲......等我开门进去，可就不止是没收外卖那么简单了。","kind":"speech","timestamp":1792309661590,"ttsGroupTimestamp":1792309661582},{"sender":"ai","content":"听到没？","kind":"speech","timestamp":1792309661591,"ttsGroupTimestamp":1792309661582}],"isIncomingCall":false,"_id":7,"summary":"秦梧與使用者視訊通話。秦梧要求使用者把鏡頭下移，查看他挑的那套衣服扣了幾顆扣子，並調侃他在微信放狠話的氣勢；使用者多半沉默、只笑著以額頭抵著螢幕。秦梧察覺使用者疑似戴上他先前調過的皮質項圈，警告若鎖扣卡太緊、勒到氣管又解不開會很麻煩。秦梧手邊鎮煞符朱砂未乾，承諾使用者若認慫就順路買熱蛋撻，否則回去不只沒收外賣；最後問「聽到沒」，通話在使用者未回應中收尾。"},{"userId":"uid_1791924747119_94hc25rhu","characterId":"42bd4a47-48ac-46c2-9fac-f45daadbdf94","id":"call_1794967277858_arzjds","timestamp":1794967275104,"charId":"42bd4a47-48ac-46c2-9fac-f45daadbdf94","duration":180,"status":"connected","logs":[{"sender":"ai","content":"接视频。","kind":"speech","timestamp":1794967277852,"ttsGroupTimestamp":1794967277852},{"sender":"ai","content":"让我看看那桌上到底有没有饭，少耍花招。","kind":"speech","timestamp":1794967277853,"ttsGroupTimestamp":1794967277852},{"sender":"ai","content":"怎么镜头黑乎乎的？","kind":"speech","timestamp":1794967302759,"ttsGroupTimestamp":1794967302759},{"sender":"ai","content":"诶，小丫头，你这是把手机扣榻上了，还是连灯都没开啊？","kind":"speech","timestamp":1794967302760,"ttsGroupTimestamp":1794967302759},{"sender":"ai","content":"让我猜猜......是不是桌上光溜溜的什么都没有，怕被我当场抓住，所以搁这儿跟老祖宗装掉线呢？","kind":"speech","timestamp":1794967302761,"ttsGroupTimestamp":1794967302759},{"sender":"user","content":"咳咳…因为我才睡醒啊","timestamp":1794967332333},{"sender":"ai","content":"咳什么咳，嗓子哑成这样，一听就是刚从被窝里拔出来。","kind":"speech","timestamp":1794967338480,"ttsGroupTimestamp":1794967338480},{"sender":"ai","content":"怎么着，刚才在论坛上跟我一唱一和的时候不挺精神的么？","kind":"speech","timestamp":1794967338481,"ttsGroupTimestamp":1794967338480},{"sender":"ai","content":"这会儿视频一通，倒跟个小病猫似的。","kind":"speech","timestamp":1794967338482,"ttsGroupTimestamp":1794967338480},{"sender":"ai","content":"把镜头拿远点，我看看你那双脚又晾在被子外面多久了。","kind":"speech","timestamp":1794967338483,"ttsGroupTimestamp":1794967338480},{"sender":"ai","content":"还有，水杯在不在手边？","kind":"speech","timestamp":1794967338484,"ttsGroupTimestamp":1794967338480},{"sender":"ai","content":"赶紧喝两口润润，省得等会儿说两句又咳起来。","kind":"speech","timestamp":1794967338485,"ttsGroupTimestamp":1794967338480},{"sender":"user","content":"刚喝了水","timestamp":1794967368906},{"sender":"ai","content":"算你听话。","kind":"speech","timestamp":1794967377901,"ttsGroupTimestamp":1794967377901},{"sender":"ai","content":"喝的温水还是凉水啊？","kind":"speech","timestamp":1794967377902,"ttsGroupTimestamp":1794967377901},{"sender":"ai","content":"要是敢背着我灌冷水，等会儿我就过去找你算账。","kind":"speech","timestamp":1794967377903,"ttsGroupTimestamp":1794967377901},{"sender":"ai","content":"既然都醒了，肚子饿不饿？","kind":"speech","timestamp":1794967377904,"ttsGroupTimestamp":1794967377901},{"sender":"ai","content":"我刚才顺路看了一眼，楼下那家砂锅牛腩可还热腾着，要不要老祖宗给你提一碗上来？","kind":"speech","timestamp":1794967377905,"ttsGroupTimestamp":1794967377901},{"sender":"user","content":"下午我要出去…就先不用了","timestamp":1794967402913},{"sender":"ai","content":"哟？","kind":"speech","timestamp":1794967410961,"ttsGroupTimestamp":1794967410961},{"sender":"ai","content":"下午还要出门？","kind":"speech","timestamp":1794967410962,"ttsGroupTimestamp":1794967410961},{"sender":"ai","content":"太阳这是打西边出来了，平时喊你挪个窝比拔游魂还难，今天怎么这么积极？","kind":"speech","timestamp":1794967410963,"ttsGroupTimestamp":1794967410961},{"sender":"ai","content":"怎么，又接什么委托了，还是跟谁约好了？","kind":"speech","timestamp":1794967410964,"ttsGroupTimestamp":1794967410961},{"sender":"ai","content":"不管去哪儿，这早饭不吃，中午饭你总得给我塞两口。","kind":"speech","timestamp":1794967410965,"ttsGroupTimestamp":1794967410961},{"sender":"ai","content":"省得下午一出门风吹两下，又跟那个纸糊的似的肚痛。","kind":"speech","timestamp":1794967410966,"ttsGroupTimestamp":1794967410961},{"sender":"user","content":"好","timestamp":1794967419574},{"sender":"ai","content":"答应得这么干脆？","kind":"speech","timestamp":1794967428149,"ttsGroupTimestamp":1794967428149},{"sender":"ai","content":"看来是真怕我顺着感应过去堵门啊。","kind":"speech","timestamp":1794967428150,"ttsGroupTimestamp":1794967428149},{"sender":"ai","content":"行了，我不逼你现在就吞一大盘牛腩，去把鞋穿上，别光着脚踩地板。","kind":"speech","timestamp":1794967428151,"ttsGroupTimestamp":1794967428149},{"sender":"ai","content":"等会儿想吃什么自己点，要是下午去办正事碰上解决不了的怪东西，记得摇宫铃叫我。","kind":"speech","timestamp":1794967428152,"ttsGroupTimestamp":1794967428149},{"sender":"ai","content":"听见没？","kind":"speech","timestamp":1794967428153,"ttsGroupTimestamp":1794967428149},{"sender":"user","content":"好，我先挂掉了，去换衣服","timestamp":1794967447325},{"sender":"ai","content":"挂吧挂吧。","kind":"speech","timestamp":1794967453959,"ttsGroupTimestamp":1794967453959},{"sender":"ai","content":"把衣服穿厚实点，别为了好看冻着。","kind":"speech","timestamp":1794967453960,"ttsGroupTimestamp":1794967453959},{"sender":"ai","content":"记得把门锁好再走。","kind":"speech","timestamp":1794967453961,"ttsGroupTimestamp":1794967453959},{"sender":"ai","content":"去吧。","kind":"speech","timestamp":1794967453962,"ttsGroupTimestamp":1794967453959}],"isIncomingCall":true,"_id":9}]